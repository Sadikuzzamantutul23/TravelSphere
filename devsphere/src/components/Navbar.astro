
---
---

<header class="navbar sticky top-0 z-50 w-full bg-white/95 backdrop-blur-xl border-b border-emerald-100/80">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="logo flex items-center gap-2">
      <span class="logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M2 12h20"/>
          <path d="M13 2 9 12l4 10"/>
          <path d="m5 5 4 7-4 7"/>
        </svg>
      </span>

      <span class="text-2xl font-extrabold tracking-tight text-gray-900">
        Travel<span class="text-emerald-600">Sphere</span><span class="text-emerald-500">.</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-9">

      <a href="/" class="nav-link active">Home</a>

      <a href="/destinations" class="nav-link">Destinations</a>

      <a href="/guides" class="nav-link">Travel Guides</a>

      <a href="/about" class="nav-link">About</a>

    </nav>

    <!-- Explore Button -->
    <a
      href="/destinations"
      class="hidden md:inline-flex items-center gap-2 explore-btn"
    >
      Explore Now
      <span>↗</span>
    </a>

    <!-- Mobile Menu Button -->
    <button
      id="menu-toggle"
      class="md:hidden mobile-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span id="menu-icon">☰</span>
    </button>

  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-emerald-100 bg-white">
    <nav class="flex flex-col px-6 py-5 gap-5">

      <a href="/" class="mobile-link">Home</a>
      <a href="/destinations" class="mobile-link">Destinations</a>
      <a href="/guides" class="mobile-link">Travel Guides</a>
      <a href="/about" class="mobile-link">About</a>

      <a href="/destinations" class="mobile-explore">
        Explore Destinations ↗
      </a>

    </nav>
  </div>
</header>

<style>
  .logo {
    text-decoration: none;
  }

  .logo-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    background: linear-gradient(135deg, #16a085, #12876f);
    border-radius: 13px;
    box-shadow: 0 5px 14px rgba(22, 160, 133, 0.22);
  }

  .nav-link {
    position: relative;
    color: #4b5563;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -9px;
    width: 0;
    height: 2px;
    background: #16a085;
    border-radius: 10px;
    transition: width 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #16a085;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .explore-btn {
    padding: 12px 21px;
    color: white;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #16a085, #12876f);
    box-shadow: 0 5px 15px rgba(22, 160, 133, 0.2);
    transition: all 0.3s ease;
  }

  .explore-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(22, 160, 133, 0.3);
  }

  .mobile-toggle {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #eaf7f3;
    color: #12876f;
    font-size: 24px;
    cursor: pointer;
  }

  .mobile-link {
    color: #374151;
    font-weight: 600;
    text-decoration: none;
  }

  .mobile-link:hover {
    color: #16a085;
  }

  .mobile-explore {
    padding: 13px 18px;
    text-align: center;
    background: #16a085;
    color: white;
    border-radius: 10px;
    font-weight: 700;
    text-decoration: none;
  }
</style>

<script>
  const menuToggle = document.querySelector("#menu-toggle");
  const mobileMenu = document.querySelector("#mobile-menu");
  const menuIcon = document.querySelector("#menu-icon");

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";

    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    mobileMenu?.classList.toggle("hidden");
    if (menuIcon) menuIcon.textContent = isOpen ? "☰" : "✕";
  });

  // Close mobile menu after navigation
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      menuToggle?.setAttribute("aria-expanded", "false");
      if (menuIcon) menuIcon.textContent = "☰";
    });
  });
</script>
