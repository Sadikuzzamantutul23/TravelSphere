
---
interface Props {
  name: string;
  country: string;
  image: string;
  description: string;
  slug: string;
  categorySlug?: string;
}

const {
  name,
  country,
  image,
  description,
  slug,
  categorySlug
} = Astro.props;

const safeCountry = country ?? "Unknown Country";
---

<article
  data-destination-card
  data-name={name.toLowerCase().trim()}
  data-country={safeCountry.toLowerCase().trim()}
  data-category={categorySlug?.toLowerCase().trim() ?? ""}
  class="group overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-xl transition duration-300"
>
  <div class="relative h-64 overflow-hidden">
    <img
      src={image}
      alt={`${name}, ${safeCountry}`}
      class="w-full h-full object-cover group-hover:scale-110 transition duration-500"
      loading="lazy"
    />

    <span class="absolute top-4 left-4 bg-white px-4 py-2 rounded-full text-sm font-semibold text-emerald-700">
      Featured
    </span>
  </div>

  <div class="p-6">
    <p class="text-sm text-emerald-600 font-semibold mb-2">
      {safeCountry}
    </p>

    <h3 class="text-xl font-bold text-gray-900 mb-3">
      {name}
    </h3>

    <p class="text-gray-500 text-sm leading-6 mb-5">
      {description}
    </p>

    <a
      href={`/destinations/${slug}`}
      class="inline-flex items-center gap-2 text-emerald-600 font-semibold hover:gap-3 transition-all"
    >
      Explore Destination →
    </a>
  </div>
</article>
