
---
import "../styles/global.css";

const { title = "TravelSphere | Explore the World" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Discover beautiful destinations and travel guides around the world."
    />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <slot />
  </body>
</html>
