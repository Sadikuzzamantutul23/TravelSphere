
---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout title="About Us | TravelSphere">
  <Navbar />

  <main class="bg-white">

    <!-- About Hero -->
    <section class="bg-[#eaf7f3] px-6 py-20 md:py-28">
      <div class="max-w-5xl mx-auto text-center">

        <p class="text-[#16a085] text-sm font-bold uppercase tracking-[0.2em] mb-5">
          About TravelSphere
        </p>

        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 leading-tight">
          Discover the World.
          <span class="text-[#16a085]">Travel with Confidence.</span>
        </h1>

        <p class="max-w-3xl mx-auto text-gray-600 text-base md:text-lg leading-8 mt-7">
          TravelSphere is a travel and destination guide designed to help
          travelers discover remarkable places, explore different cultures
          and plan meaningful journeys with confidence.
        </p>

      </div>
    </section>

    <!-- Introduction -->
    <section class="max-w-7xl mx-auto px-6 py-20 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">

        <div class="lg:col-span-5">
          <p class="text-[#16a085] text-sm font-bold uppercase tracking-widest mb-3">
            Who We Are
          </p>

          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight">
            Making travel discovery simpler and more meaningful.
          </h2>
        </div>

        <div class="lg:col-span-7 space-y-5 text-gray-600 leading-8 text-base md:text-lg">
          <p>
            Every journey begins with curiosity. It might be the desire to
            explore a new country, experience a different culture or discover
            a peaceful destination away from everyday life.
          </p>

          <p>
            But planning a journey often involves finding reliable information,
            comparing destinations and understanding what each place has to offer.
          </p>

          <p>
            TravelSphere brings destination information and practical travel
            guides together in one place, helping travelers make more informed
            decisions before setting off on their next adventure.
          </p>
        </div>

      </div>
    </section>

    <!-- Mission & Vision -->
    <section class="bg-[#f7fbf9] px-6 py-20 md:py-24">
      <div class="max-w-7xl mx-auto">

        <div class="max-w-2xl mb-12">
          <p class="text-[#16a085] text-sm font-bold uppercase tracking-widest mb-3">
            Our Purpose
          </p>

          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
            What Drives TravelSphere
          </h2>

          <p class="text-gray-600 leading-7 mt-4">
            Our goal is to make discovering and planning travel easier
            through useful information and thoughtful content.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-7">

          <!-- Mission -->
          <article class="bg-white border border-gray-100 rounded-2xl p-8 md:p-10 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-[#eaf7f3] flex items-center justify-center text-[#16a085] text-2xl font-bold">
              M
            </div>

            <h3 class="text-2xl font-bold text-gray-900 mt-7">
              Our Mission
            </h3>

            <p class="text-gray-600 leading-8 mt-4">
              To provide accessible destination information and practical
              travel resources that help people explore the world, understand
              new places and plan their journeys with confidence.
            </p>
          </article>

          <!-- Vision -->
          <article class="bg-white border border-gray-100 rounded-2xl p-8 md:p-10 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-[#eaf7f3] flex items-center justify-center text-[#16a085] text-2xl font-bold">
              V
            </div>

            <h3 class="text-2xl font-bold text-gray-900 mt-7">
              Our Vision
            </h3>

            <p class="text-gray-600 leading-8 mt-4">
              To become a trusted travel discovery platform where travelers
              can find inspiration, learn about destinations and access
              useful resources for their adventures around the world.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- What We Offer -->
    <section class="max-w-7xl mx-auto px-6 py-20 md:py-24">

      <div class="max-w-2xl mb-12">
        <p class="text-[#16a085] text-sm font-bold uppercase tracking-widest mb-3">
          Explore TravelSphere
        </p>

        <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
          Everything Starts with Discovery
        </h2>

        <p class="text-gray-600 leading-7 mt-4">
          Explore different parts of the platform and find information
          to help you prepare for your next journey.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-7">

        <article class="border-l-4 border-[#16a085] bg-[#f7fbf9] p-7 rounded-r-2xl">
          <h3 class="text-xl font-bold text-gray-900">
            Destination Discovery
          </h3>

          <p class="text-gray-600 leading-7 mt-4">
            Explore destinations across different countries and discover
            places based on your interests and travel preferences.
          </p>

          <a
            href="/destinations"
            class="inline-flex items-center gap-2 text-[#16a085] font-semibold mt-6 hover:gap-3 transition-all"
          >
            Explore Destinations →
          </a>
        </article>

        <article class="border-l-4 border-[#16a085] bg-[#f7fbf9] p-7 rounded-r-2xl">
          <h3 class="text-xl font-bold text-gray-900">
            Travel Guides
          </h3>

          <p class="text-gray-600 leading-7 mt-4">
            Find practical travel tips, planning advice and useful information
            to prepare for different travel experiences.
          </p>

          <a
            href="/guides"
            class="inline-flex items-center gap-2 text-[#16a085] font-semibold mt-6 hover:gap-3 transition-all"
          >
            Read Travel Guides →
          </a>
        </article>

        <article class="border-l-4 border-[#16a085] bg-[#f7fbf9] p-7 rounded-r-2xl">
          <h3 class="text-xl font-bold text-gray-900">
            Country Exploration
          </h3>

          <p class="text-gray-600 leading-7 mt-4">
            Learn about different countries and discover destinations
            connected to their unique locations and experiences.
          </p>

          <a
            href="/countries"
            class="inline-flex items-center gap-2 text-[#16a085] font-semibold mt-6 hover:gap-3 transition-all"
          >
            Explore Countries →
          </a>
        </article>

      </div>
    </section>

    <!-- Closing CTA -->
    <section class="px-6 pb-20 md:pb-24">
      <div class="max-w-7xl mx-auto bg-[#eaf7f3] rounded-3xl px-7 py-14 md:px-16 md:py-16 text-center">

        <p class="text-[#16a085] text-sm font-bold uppercase tracking-widest mb-4">
          Your Next Journey Starts Here
        </p>

        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 max-w-2xl mx-auto leading-tight">
          The World Is Waiting to Be Explored.
        </h2>

        <p class="text-gray-600 leading-7 max-w-xl mx-auto mt-5">
          Start discovering destinations and find inspiration
          for the journey ahead.
        </p>

        <a
          href="/destinations"
          class="inline-flex items-center gap-2 bg-[#16a085] hover:bg-[#12876f] text-white px-8 py-4 rounded-xl font-semibold mt-8 transition duration-300"
        >
          Discover Destinations
          <span aria-hidden="true">→</span>
        </a>

      </div>
    </section>

  </main>

  <Footer />
</MainLayout>
