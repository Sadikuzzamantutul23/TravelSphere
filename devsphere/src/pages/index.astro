

---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import DestinationCard from "../components/DestinationCard.astro";

import { sanityClient } from "../lib/sanity";
import { urlFor } from "../lib/image";

interface Destination {
  _id: string;
  name: string;
  country: string;
  description: string;
  slug: string;
  mainImage: {
    _type: "image";
    asset: {
      _ref: string;
      _type: "reference";
    };
  };
}

interface Category {
  _id: string;
  title: string;
  slug: string;
  description?: string;
  image?: any;
}

const categoryQuery = `*[_type == "category" && defined(slug.current)] | order(title asc) {
  _id,
  title,
  "slug": slug.current,
  description,
  image
}`;

const categories: Category[] = await sanityClient.fetch(categoryQuery);

interface Country {
  _id: string;
  name: string;
  slug: string;
  description: string;
  flag?: any;
  coverImage?: any;
}

const countryQuery = `*[_type == "country" && defined(slug.current)] | order(name asc) {
  _id,
  name,
  "slug": slug.current,
  description,
  flag,
  coverImage
}`;

const countries: Country[] = await sanityClient.fetch(countryQuery);

const query = `*[_type == "destination" && featured == true] {
  _id,
  name,
  "country": country->name,
  description,
  mainImage,
  "slug": slug.current
}`; 

const destinations = await sanityClient.fetch(query);
---


<MainLayout title="TravelSphere | Explore the World">

  <Navbar />

  <main>

    <!-- Hero Section -->

<section class="hero-section min-h-[650px] flex items-center px-[8%] bg-emerald-50 overflow-hidden">

  <!-- Left Content -->
