
---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

import { sanityClient } from "../../lib/sanity";
import { urlFor } from "../../lib/image";
import { toHTML } from "@portabletext/to-html";

interface Guide {
  _id: string;
  title: string;
  slug: string;
  excerpt: string;
  category: string;
  author: string;
  readingTime: number;
  publishedAt?: string;
  coverImage?: any;
  content: any[];
}

interface RelatedGuide {
  _id: string;
  title: string;
  slug: string;
  excerpt: string;
  category: string;
  coverImage?: any;
}

export async function getStaticPaths() {
  const query = `*[_type == "guide" && defined(slug.current)] {
    _id,
    title,
    "slug": slug.current,
    excerpt,
    category,
    author,
    readingTime,
    publishedAt,
    coverImage,
    content
  }`;

  const guides: Guide[] = await sanityClient.fetch(query);

  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

function formatCategory(category?: string) {
  if (!category) return "Travel Guide";

  return category
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

const publishedDate = guide.publishedAt
  ? new Date(guide.publishedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";

const articleHTML = toHTML(guide.content ?? [], {
  components: {
    types: {
      image: ({ value }) => {
        if (!value?.asset?._ref) return "";

        const imageUrl = urlFor(value)
          .width(1200)
          .url();

        return `<figure class="my-10">
          <img
            src="${imageUrl}"
            alt="${value.alt || guide.title}"
            class="w-full rounded-2xl object-cover"
            loading="lazy"
          />
          ${value.caption ? `<figcaption class="text-center text-sm text-gray-500 mt-3">${value.caption}</figcaption>` : ""}
        </figure>`;
      },
    },
  },
});

const relatedQuery = `*[
  _type == "guide" &&
  _id != $currentId &&
  category == $category &&
  defined(slug.current)
] | order(publishedAt desc)[0...3] {
  _id,
  title,
  "slug": slug.current,
  excerpt,
  category,
  coverImage
}`;

const relatedGuides: RelatedGuide[] = await sanityClient.fetch(
  relatedQuery,
  {
    currentId: guide._id,
    category: guide.category,
  }
);
---

<MainLayout title={`${guide.title} | TravelSphere`}>
  <Navbar />

  <main class="bg-white">

    <!-- Article Header -->
    <section class="bg-[#eaf7f3] px-6 pt-12 pb-16 md:pt-16 md:pb-20">
      <div class="max-w-4xl mx-auto">

        <a
          href="/guides"
          class="inline-flex items-center gap-2 text-[#12876f] font-semibold text-sm hover:gap-3 transition-all"
        >
          <span aria-hidden="true">←</span>
          Back to Travel Guides
        </a>

        <div class="mt-9">
          <span class="inline-block bg-white text-[#12876f] px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider">
            {formatCategory(guide.category)}
          </span>

          <h1 class="text-3xl md:text-5xl font-bold text-gray-900 leading-tight mt-6">
            {guide.title}
          </h1>

          <p class="text-gray-600 text-base md:text-lg leading-8 mt-6 max-w-3xl">
            {guide.excerpt}
          </p>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-8 text-sm text-gray-600">
            <span>
              By <strong class="text-gray-900">{guide.author}</strong>
            </span>

            {publishedDate && (
              <span>{publishedDate}</span>
            )}

            <span>{guide.readingTime} min read</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Cover Image -->
    {guide.coverImage && (
      <section class="max-w-7xl mx-auto px-6 -mt-2">
        <div class="overflow-hidden rounded-2xl md:rounded-3xl shadow-lg">
          <img
            src={urlFor(guide.coverImage).width(1800).url()}
            alt={guide.title}
            class="w-full h-[280px] md:h-[500px] object-cover"
          />
        </div>
      </section>
    )}

    <!-- Article Content -->
    <section class="max-w-7xl mx-auto px-6 py-16 md:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-12 lg:gap-16">

        <article class="min-w-0">

          <div
            class="guide-content text-gray-700 text-base md:text-lg leading-8"
            set:html={articleHTML}
          />

          <div class="mt-14 pt-8 border-t border-gray-200">
            <a
              href="/guides"
              class="inline-flex items-center gap-2 bg-[#16a085] hover:bg-[#12876f] text-white px-6 py-3 rounded-xl font-semibold transition"
            >
              Explore More Guides
              <span aria-hidden="true">→</span>
            </a>
          </div>

        </article>

        <!-- Article Sidebar -->
        <aside class="lg:sticky lg:top-24 h-fit">
          <div class="bg-[#eaf7f3] rounded-2xl p-7">
            <p class="text-[#12876f] text-xs font-bold uppercase tracking-widest">
              About This Guide
            </p>

            <h2 class="text-xl font-bold text-gray-900 mt-4">
              Travel Knowledge
            </h2>

            <p class="text-gray-600 text-sm leading-7 mt-3">
              Practical information and inspiration to help you
              prepare for your next journey.
            </p>

            <div class="border-t border-[#cce8de] mt-6 pt-5 space-y-4">
              <div>
                <p class="text-xs text-gray-500">Written by</p>
                <p class="font-semibold text-gray-900 mt-1">
                  {guide.author}
                </p>
              </div>

              <div>
                <p class="text-xs text-gray-500">Reading time</p>
                <p class="font-semibold text-gray-900 mt-1">
                  {guide.readingTime} minutes
                </p>
              </div>

              <div>
                <p class="text-xs text-gray-500">Category</p>
                <p class="font-semibold text-gray-900 mt-1">
                  {formatCategory(guide.category)}
                </p>
              </div>
            </div>

            <a
              href="/destinations"
              class="block text-center mt-7 bg-[#16a085] hover:bg-[#12876f] text-white py-3 rounded-xl font-semibold transition"
            >
              Explore Destinations
            </a>
          </div>
        </aside>

      </div>
    </section>

    <!-- Related Guides -->
    {relatedGuides.length > 0 && (
      <section class="bg-[#f7fbf9] px-6 py-16 md:py-20">
        <div class="max-w-7xl mx-auto">

          <div class="mb-10">
            <p class="text-[#16a085] text-sm font-bold uppercase tracking-widest mb-2">
              Keep Exploring
            </p>

            <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
              Related Travel Guides
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7">
            {relatedGuides.map((related) => (
              <article class="group overflow-hidden rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-xl transition duration-300">

                <a href={`/guides/${related.slug}`}>
                  {related.coverImage && (
                    <div class="h-56 overflow-hidden bg-[#eaf7f3]">
                      <img
                        src={urlFor(related.coverImage).width(900).url()}
                        alt={related.title}
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                      />
                    </div>
                  )}
                </a>

                <div class="p-6">
                  <span class="text-[#12876f] text-xs font-semibold uppercase">
                    {formatCategory(related.category)}
                  </span>

                  <a href={`/guides/${related.slug}`}>
                    <h3 class="text-xl font-bold text-gray-900 mt-3 group-hover:text-[#16a085] transition">
                      {related.title}
                    </h3>
                  </a>

                  <p class="text-gray-600 text-sm leading-7 mt-3 line-clamp-3">
                    {related.excerpt}
                  </p>

                  <a
                    href={`/guides/${related.slug}`}
                    class="inline-block text-[#16a085] font-semibold text-sm mt-5"
                  >
                    Read More →
                  </a>
                </div>

              </article>
            ))}
          </div>

        </div>
      </section>
    )}

  </main>

  <Footer />
</MainLayout>

<style>
  .guide-content :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .guide-content :global(h2) {
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.4;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .guide-content :global(h3) {
    font-size: 1.3rem;
    font-weight: 600;
    color: #111827;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .guide-content :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.9;
  }

  .guide-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
  }

  .guide-content :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
  }

  .guide-content :global(li) {
    padding-left: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .guide-content :global(blockquote) {
    border-left: 4px solid #16a085;
    background: #eaf7f3;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    border-radius: 0 0.75rem 0.75rem 0;
    color: #374151;
  }

  .guide-content :global(a) {
    color: #12876f;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .guide-content :global(strong) {
    color: #111827;
    font-weight: 700;
  }

  .guide-content :global(figure img) {
    max-height: 550px;
  }
</style>
