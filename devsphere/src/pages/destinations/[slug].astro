
---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

import { sanityClient } from "../../lib/sanity";
import { urlFor } from "../../lib/image";

interface Destination {
  _id: string;
  name: string;
  country: string;
  description: string;
  slug: string;
  mainImage?: any;
}

export async function getStaticPaths() {
  const query = `*[_type == "destination" && defined(slug.current)] {
    _id,
    name,
    country,
    description,
    mainImage,
    "slug": slug.current
  }`;

  const destinations: Destination[] = await sanityClient.fetch(query);

  return destinations.map((destination) => ({
    params: { slug: destination.slug },
    props: { destination },
  }));
}

const { destination } = Astro.props;

const imageUrl = destination.mainImage
  ? urlFor(destination.mainImage).width(1200).url()
  : null;
---

<MainLayout title={`${destination.name} | TravelSphere`}>
  <Navbar />

  <main class="max-w-7xl mx-auto px-6 py-12">
    <a
      href="/"
      class="text-emerald-600 font-semibold hover:underline"
    >
      ← Back to Home
    </a>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">

      <div>
        <p class="text-emerald-600 font-bold uppercase tracking-widest mb-3">
          {destination.country}
        </p>

        <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6">
          {destination.name}
        </h1>

        <p class="text-gray-600 text-lg leading-8">
          {destination.description}
        </p>
      </div>

      {imageUrl && (
        <div class="overflow-hidden rounded-2xl">
          <img
            src={imageUrl}
            alt={destination.name}
            class="w-full h-[400px] object-cover"
          />
        </div>
      )}

    </div>
  </main>

  <Footer />
</MainLayout>
